DEBUG=true
DATABASE_URL=sqlite:///./edupilot.db
CHROMA_PATH=./chroma_data
CORS_ORIGINS=http://localhost:3000
DEV_MODE=true

NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# ⚠️  REQUIRED: Get from Supabase Dashboard → Project Settings → API → JWT Settings
# Without this, JWT auth fails and ONLY the dev_mode author's machine can authenticate.
SUPABASE_JWT_SECRET=<your-supabase-jwt-secret>

ENABLED_CONNECTORS=aicte

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:120b-cloud
OLLAMA_TEMPERATURE=0.7

SENDGRID_API_KEY=<your-sendgrid-key>
SENDGRID_FROM_EMAIL=<your-email>
SENDGRID_FROM_NAME=EduPilot

TWILIO_ACCOUNT_SID=<your-twilio-sid>
TWILIO_AUTH_TOKEN=<your-twilio-token>
TWILIO_FROM_PHONE=<your-twilio-phone>
TWILIO_VERIFY_SERVICE_SID=<your-twilio-verify-sid>

NOTIFICATION_FROM_EMAIL=<your-email>

TEE_MODE=mock

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=edupilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<your-postgres-password>
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=15
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

GEMINI_API_KEY=<your-gemini-key>
GOOGLE_API_KEY=<your-google-key>

JUDGE_PROVIDER=ollama
JUDGE_MODEL=gemma4:31b-cloud

GROQ_API_KEY=<your-groq-key>
GROQ_MODEL=openai/gpt-oss-120b
